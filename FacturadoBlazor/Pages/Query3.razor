@page "/query3"
@using FacturadoBlazor.Service
@using FacturadorModels.Models
@inject FacturaService FacturaService
@inject ArticuloService articuloService
<h3>Facturas Articulo con ID igual a AGD_123</h3>

@if (facturas == null)
{
    <p>Cargando datos...</p>
}
else if (facturas.Count == 0)
{
    <p>No hay facturas del mes anterior que superen los $10.000.</p>
}
else
{
    <div class="card" style="width:100%;">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Nº Factura</th>
                            <th>Fecha</th>
                            <th>Razon Social</th>
                            <th>Cuit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in facturascod)
                        {
                            @foreach (var d in f.Detalles)
                            {
                                var articulo = articulos.FirstOrDefault(a => a.ArtId == d.ART_ID);

                                <tr>
                                    <td>@f.FC_ID</td>
                                    <td>@f.FechaAlta.ToString("dd/MM/yyyy")</td>
                                    <td>@articulo?.ArtId</td>
                                    <td>@d.Cant</td>
                                    <td>@($"${d.Precio:N2}")</td>
                                    <td>@($"${d.Monto:N2}")</td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="2"><strong>Total general</strong></td>
                            <td><strong>@($"${facturas.Sum(f => f.Detalles.Sum(d => d.Monto)):N2}")</strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private List<FacturaVista> facturas;
    private List<Articulo> articulos;
    private List<FacturaVista> facturascod;

    protected override async Task OnInitializedAsync()
    {
        facturas = await FacturaService.ObtenerFacturaAsync();
        articulos = await articuloService.ObtenerArticuloAsync();
        facturascod = facturas
            .Where(f => f.Detalles.Any(d => d.ART_ID == "AGD_123"))
            .ToList();

    }
}
