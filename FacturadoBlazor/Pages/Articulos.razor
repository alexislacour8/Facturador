@page "/articulos"
@using FacturadoBlazor.Service
@using FacturadorModels.Models
@using FacturadoBlazor.ValidarInputs;
@using FluentValidation.Results
@inject ArticuloService ArticuloService

<h3>Articulos</h3>

<!-- Botón para nuevo cliente -->
<button type="button" class="btn btn-primary mb-3" @onclick="AbrirModal">Nuevo</button>


<!-- Tabla responsive con Bootstrap -->
<div class="card" style="width:95%;">
  <div class="card-body">
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (articulos != null)
            {
                @foreach (var a in articulos)
                {
                    <tr>
                        <td>@a.Nombre</td>
                        <td>@a.Precio</td>
                        <td>@a.Stock</td>
                        <td>
                            <button class="btn btn-sm btn-primary me-2" @onclick="() => EditarCliente(a.ArtId)">Editar</button>
                          <button class="btn btn-sm btn-danger" @onclick="() => EliminarCliente(a.ArtId)">Eliminar</button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">No hay clientes cargados</td>
                </tr>
            }
        </tbody>
    </table>
</div>
    </div>
</div>
@if (mostrarModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(
                                            eliminar
                                            ? "Eliminar Articulo"
                                            : (editar ? "Editar Articulo" : "Nuevo Articulo")
                                            )
                </h5>
                <button type="button" class="btn-close" @onclick="CerrarModal"></button>
            </div>

                <div class="modal-body">
                @if (eliminar)
                    {
                        <p>¿Estás seguro de que querés eliminar el Articulo? <strong>@nuevoArticulo.Nombre</strong>?</p>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Codigo</label>
                            <input type="text" class="form-control" @bind="nuevoArticulo.ArtId" />
                            @MostrarError("Nombre")
                        </div>
                 
                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <input type="text" class="form-control" @bind="nuevoArticulo.Nombre" />
                            @MostrarError("Nombre")
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Precio</label>
                            <input type="text" class="form-control" @bind="nuevoArticulo.Precio" />
                            @MostrarError("Precio")
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Stock</label>
                            <input type="text" class="form-control" @bind="nuevoArticulo.Stock" />
                            @MostrarError("Stock")
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>

                    @if (eliminar)
                    {
                      <button class="btn btn-danger" @onclick="ConfirmarEliminar">Eliminar</button>
                    }
                    @if(editar)
                    {
                        <button class="btn btn-primary" @onclick="GuardarArticulo">Actualizar</button>
                    }
                    else
                    {
                        <button class="btn btn-primary" @onclick="GuardarArticulo">Guardar</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Articulo> articulos;
    private bool mostrarModal = false;
    private bool editar = false;
    private bool eliminar = false;
    private Articulo nuevoArticulo = new Articulo();
    private ArticuloValidation validator = new ArticuloValidation();
    private ValidationResult validationResult = new ValidationResult();
    protected override async Task OnInitializedAsync()
    {
        try
        {
            articulos = await ArticuloService.ObtenerArticuloAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task AbrirModal()
    {
        nuevoArticulo = new Articulo();
        editar = false;
        eliminar = false;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task GuardarArticulo()
    {
        validationResult = validator.Validate(nuevoArticulo);

        if (!validationResult.IsValid)
        {
            return; // No guarda hasta que los campos sean válidos
        }
        if (editar)
        {
            await ArticuloService.UpdateArticuloAsync(nuevoArticulo.ArtId, nuevoArticulo);
        }
        else
        {
            await ArticuloService.AddArticuloAsync(nuevoArticulo);
        }

        articulos = await ArticuloService.ObtenerArticuloAsync();
        mostrarModal = false;
    }

    private void EditarCliente(string codigo)
    {
        var articulo = articulos.FirstOrDefault(c => c.ArtId == codigo);
        if (articulo != null)
        {
            nuevoArticulo = new Articulo
            {
                ArtId = articulo.ArtId,
                Nombre = articulo.Nombre,
                Precio =  articulo.Precio,
                Stock = articulo.Stock,
               
            };
            editar = true;
            eliminar = false;
            mostrarModal = true;
        }
    }

    private void EliminarCliente(string codigo)
    {
        var articulo = articulos.FirstOrDefault(c => c.ArtId == codigo);
        if (articulo != null)
        {
            nuevoArticulo = new Articulo
            {
                ArtId = articulo.ArtId,
                Nombre = articulo.Nombre,
                Precio = articulo.Precio,
                Stock = articulo.Stock,

            };
            editar = false;
            eliminar = true;
            mostrarModal = true;
        }
    }

    private async Task ConfirmarEliminar()
    {
        await ArticuloService.DesactivarArticulo(nuevoArticulo.ArtId);
        articulos = await ArticuloService.ObtenerArticuloAsync();
        mostrarModal = false;
    }
    private RenderFragment MostrarError(string campo) => builder =>
   {
       var errores = validationResult.Errors
           .Where(e => e.PropertyName == campo)
           .Select(e => e.ErrorMessage)
           .ToList();

       if (errores.Any())
       {
           builder.OpenElement(0, "div");
           builder.AddAttribute(1, "class", "text-danger small mt-1");
           builder.AddContent(2, string.Join(", ", errores));
           builder.CloseElement();
       }
   };
}
